# Copy to .env (never commit .env). Used by docker-compose.yml
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-value
DB_PASSWORD=change-me-use-a-strong-password
# Comma separated browser origins allowed to call the API in production
CORS_ORIGIN=
# true = load demo users/cases (never in a real deployment)
ALLOW_DEMO_DATA=false
